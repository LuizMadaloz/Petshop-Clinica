<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CleniPet</title>
</head>
<body>
    <%- include("header.ejs") %>
    <h1>Relatórios</h1>
 
    

    <label for="opcoes">Selecione uma opção</label>
    <select name="opcoes" id="opcoes" onchange="alternarFormulario(this.value)">
        <option value="">-- Escolha um relatório --</option>
        <option value="opcao1">Relatórios dos funcionários</option>
        <option value="opcao2">Relatórios de Vendas</option>
    </select>


    
    <div id="form-funcionarios" style="display: none; margin-top: 20px;">
        <form action="/relatorios" method="POST">
            <input type="hidden" name="tipo" value="funcionarios">
            <label for="busca">Digite o nome do funcionário:</label>
            <input type="text" name="busca" placeholder="Ex: Carlos">
            <label for="buscaCpf">Digite o Cpf</label>
            <input type="text" name="buscaCpf">
            <button type="submit">Buscar</button>
        </form>
    </div>

    
    <div id="form-vendas" style="display: none; margin-top: 20px;">
        <form action="/relatorios" method="POST">
            <input type="hidden" name="tipo" value="vendas">
            <label for="busca-venda">Digite o ID ou filtro da venda:</label>
            <input type="text" name="busca" id="busca-venda" placeholder="Ex: 1023">
            <button type="submit">Buscar Vendas</button>
        </form>
    </div>

   <% if (locals.funcionarios) { %>
    <% funcionarios.forEach(funcionario => { %>
      
        <p>Nome: <%= funcionario.nomeF %></p>
        <p>ID: <%= funcionario.id %></p> 
        <p>Cpf: <%= funcionario.cpf %></p>
        <hr>
    <% }); %>
<% } %>


    <script>
    function alternarFormulario(opcaoSelecionada) {
        const formFuncionarios = document.getElementById('form-funcionarios');
        const formVendas = document.getElementById('form-vendas');

       
        formFuncionarios.style.display = 'none';
        formVendas.style.display = 'none';

     
        if (opcaoSelecionada === 'opcao1') {
            formFuncionarios.style.display = 'block';
        } else if (opcaoSelecionada === 'opcao2') {
            formVendas.style.display = 'block';
        }
    }
    </script>
</body>
</html>